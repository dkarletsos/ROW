\name{ncds}
\alias{ncds}
\docType{data}
\title{National Child Development Study: education and wages}
\description{Subset of the UK National Child Development Study (Battistin and Sianesi, 2011) as
distributed (CC0) with the R package PSweight: 3,642 people, three levels of educational
attainment (\code{Dmult}: "None", "O/eq", ">=A/eq"), log hourly wage (\code{wage}) and childhood
and family covariates.}
\usage{data(ncds)}
\format{A data frame with 3642 rows and 16 columns: \code{white}, \code{wage}, \code{Dany},
\code{Dmult}, \code{maemp}, \code{scht}, \code{qmab}, \code{qmab2}, \code{qvab}, \code{qvab2},
\code{paed_u}, \code{maed_u}, \code{agepa}, \code{agema}, \code{sib_u}, \code{wagebin}.}
\source{Battistin E, Sianesi B (2011). Misclassified treatment status and treatment effects: an
application to returns to education in the United Kingdom. Review of Economics and Statistics
93(2), 495-509. Distributed with PSweight (Zhou, Tong, Li, Thomas and Li, 2022).}
\keyword{datasets}
