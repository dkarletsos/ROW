\alias{ROW}
\docType{package}
\title{ROW: regularised outcome-weighted estimation of the average treatment effect}
\description{Estimation of the average treatment effect for two or more treatments under limited
overlap, with an outcome-blind balance rule for the regularisation parameter and sandwich
standard errors. Main function: \code{\link{row_ate}}; see also \code{\link{row_path}}.}
\author{Dimitris Karletsos}
\keyword{package}
